# ---------------------------------------------------------------------------
# Copy to .env.local for local development. On Vercel these go in
# Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# Postgres connection string. Adding Neon from the Vercel marketplace sets this
# for you. Use the POOLED connection string, the one containing "-pooler".
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs the dashboard session cookie. Any long random string.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Protects the one-time /setup page. Change it, and after setup you can delete it.
SETUP_SECRET="change-me-too"

# Set automatically when you add Blob storage to the Vercel project.
# Without it, image fields still accept a pasted URL.
BLOB_READ_WRITE_TOKEN=""

# Your live address, no trailing slash. Used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL="https://bikeshadhikari.com.np"
