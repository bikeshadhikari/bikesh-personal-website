# Uploaded files are served, never executed.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_rewrite.c>
    RewriteEngine Off
</IfModule>
<FilesMatch "\.(php|php[0-9]|phtml|phar|pl|py|cgi|sh|htaccess)$">
    Require all denied
</FilesMatch>
Options -Indexes -ExecCGI
AddHandler cgi-script .php .phtml .pl .py
